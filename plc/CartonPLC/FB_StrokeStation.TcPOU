<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.53">
  <POU Name="FB_StrokeStation" Id="{52592E20-A431-4FDA-93CC-000000000010}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StrokeStation
VAR_OUTPUT
    Phase : DINT; // Outstroke 0..100, return 101..200
    Done : BOOL;
END_VAR
VAR
    Cylinder : FB_VirtualCylinder;
    Returning : BOOL;
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[]]></ST></Implementation>
    <Method Name="ResetStation" Id="{52592E20-A431-4FDA-93CC-000000000008}">
      <Declaration><![CDATA[METHOD ResetStation]]></Declaration>
      <Implementation><ST><![CDATA[Cylinder.Home();
Returning := FALSE;
Phase := 0;
Done := FALSE;]]></ST></Implementation>
    </Method>
    <Method Name="Step" Id="{52592E20-A431-4FDA-93CC-000000000009}">
      <Declaration><![CDATA[METHOD Step]]></Declaration>
      <Implementation><ST><![CDATA[IF Done THEN RETURN; END_IF
Cylinder.Move(Forward := NOT Returning);
IF Returning THEN
    Phase := 200 - Cylinder.Position;
    Done := Cylinder.Position = 0;
ELSE
    Phase := Cylinder.Position;
    Returning := Cylinder.Position = 100;
END_IF]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
